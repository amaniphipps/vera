# Secrets — never commit
.env
*.key
*.pem
*.p8

# Deployment-specific policy — only the example ships
policy/guardrails.yaml

# Local Python environments (dirs and venv symlinks)
.venv
.venv/
.test-venv/

# Runtime output — each deployment builds its own
memory/profile.md
memory/stores.yaml
memory/durable/*
!memory/durable/.gitkeep
skills-live/*
!skills-live/.gitkeep
knowledge/graph/entities/*/*
!knowledge/graph/entities/*/.gitkeep
knowledge/graph/evidence/*
!knowledge/graph/evidence/.gitkeep
**/env/org.yaml
**/env/drift.log

# Python / Node / OS
__pycache__/
*.pyc
node_modules/
.DS_Store

# Project-local Hermes runtime and secrets
.hermes/
.local-home/
