# ─────────────────────────────────────────────────────────────
# Vera configuration — copy to .env and fill in. .env is git-ignored.
# Grouped: REQUIRED → PICK ONE → OPTIONAL.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────
# Model provider. OpenRouter is the documented default (one key, many models).
OPENROUTER_API_KEY=sk-or-xxx
# Direct-provider alternatives (see deploy/hermes/providers/):
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# Default model (any OpenRouter slug, or a direct provider model)
VERA_MODEL=anthropic/claude-sonnet-4.5

# ── PICK ONE (the platform Vera meets you on) ─────────────────
# Slack
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_APP_TOKEN=xapp-xxx
# VERA_SLACK_CHANNEL=C0123456789          # where Vera says hello
# Vera is Slack-first. Other platforms (WhatsApp, SMS, GroupMe, Teams) are
# supported by Hermes upstream - ask Vera to help you wire one; see docs/DEPLOYMENT.md

# ── OPTIONAL ──────────────────────────────────────────────────
# Memory: MEMORY.md works out of the box. For a real database, Supabase is
# the recommended shell (memory/supabase/). Hindsight plugin for durable memory.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=xxx
# HINDSIGHT_ENABLED=true

# Capability acquisition (optional): REA MCP for analyzing apps/connectors.
# REA_ENABLED=true

# Serve only your org's email domain (empty = everyone)
# VERA_SERVE_ONLY_DOMAIN=yourcompany.com

# Timezone for briefings and cron
# VERA_TIMEZONE=America/New_York

# ── NON-INTERACTIVE SETUP (./setup/setup.sh --non-interactive) ──────
# Answers are read from these vars instead of prompts.
# VERA_PROVIDER=openrouter          # openrouter | anthropic | openai | gemini
# VERA_PLATFORM=cli                 # cli | slack
# VERA_SKIP_HELLO=0                 # 1 = don't run the first-run hello
